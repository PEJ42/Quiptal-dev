# Local SQLite database for development. Do not commit your .env file.
DATABASE_URL="file:./prisma/dev.db"
# Optional locally; required in production. Stores private uploads and contracts.
APP_DATA_DIR="./storage"
# Stripe test-mode credentials. Keep these server-side and never commit real values.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Public base URL used for Stripe return URLs and customer signing links.
APP_URL="http://localhost:3000"
