generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  username           String?             @unique
  passwordHash       String
  role               String              @default("ADMIN")
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  bookingActivities  BookingActivity[]
  generatedContracts GeneratedContract[]
  memberships        TeamMembership[]
  createdBookings    Booking[]          @relation("BookingCreator")
  ownedBookings      Booking[]          @relation("BookingOwner")
  bookingMemberships BookingMember[]
  completedChecklistSteps BookingChecklistStep[] @relation("ChecklistStepCompletedBy")
  completedChecklists    BookingChecklist[]     @relation("ChecklistCompletedBy")
  checklistLinksCreated  BookingChecklistLink[] @relation("ChecklistLinkCreatedBy")
  invitationsCreated TeamInvitation[]   @relation("InvitationCreator")
  activeTeamId       String?
}

model Team {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships TeamMembership[]
  invitations TeamInvitation[]
  bookings    Booking[]
}

model TeamMembership {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, role])
}

model TeamInvitation {
  id             String   @id @default(cuid())
  teamId         String
  recipientEmail String
  tokenHash      String   @unique
  createdById    String
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([teamId, recipientEmail])
  @@index([recipientEmail])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model CompanySettings {
  id                        String   @id @default("default")
  name                      String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  region                    String?
  postalCode                String?
  country                   String?
  phone                     String?
  email                     String?
  website                   String?
  logoReference             String?
  timezone                  String   @default("America/Denver")
  currency                  String   @default("USD")
  defaultTaxRateBasisPoints Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model BookingType {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model BookingStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Service {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  defaultPriceCents Int      @default(0)
  isTaxable         Boolean  @default(true)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Customer {
  id                  String               @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  normalizedEmail     String
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  country             String?
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contacts            CustomerContact[]
  bookings            Booking[]
  savedPaymentMethods SavedPaymentMethod[]

  @@index([normalizedEmail])
  @@index([lastName, firstName])
  @@index([archivedAt])
}

model CustomerContact {
  id                 String    @id @default(cuid())
  customerId         String
  name               String
  email              String?
  phone              String?
  relationship       String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  primaryForBookings Booking[]

  @@index([customerId])
  @@index([archivedAt])
}

model Product {
  id                   String            @id @default(cuid())
  name                 String
  description          String?
  categoryId           String
  defaultRentalCents   Int               @default(0)
  replacementCostCents Int?
  isTaxable            Boolean           @default(true)
  imageReference       String?
  archivedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  category             ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bundleComponents     BundleComponent[]

  @@index([categoryId])
  @@index([archivedAt])
}

model Bundle {
  id               String            @id @default(cuid())
  name             String
  description      String?
  fixedRentalCents Int               @default(0)
  isTaxable        Boolean           @default(true)
  imageReference   String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  components       BundleComponent[]

  @@index([archivedAt])
}

model BundleComponent {
  id           String  @id @default(cuid())
  bundleId     String
  productId    String
  quantity     Int
  displayOrder Int     @default(0)
  bundle       Bundle  @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bundleId, displayOrder])
  @@index([productId])
}

model Booking {
  id                           String                 @id @default(cuid())
  bookingNumber                String                 @unique
  title                        String?
  customerId                   String
  teamId                       String?
  createdByUserId              String?
  ownerUserId                  String?
  primaryContactId             String?
  startDate                    DateTime
  endDate                      DateTime
  bookingTypeId                String
  bookingStatusId              String
  eventAddressLine1            String?
  eventAddressLine2            String?
  eventCity                    String?
  eventRegion                  String?
  eventPostalCode              String?
  eventCountry                 String?
  billingAddressLine1Snapshot  String?
  billingAddressLine2Snapshot  String?
  billingCitySnapshot          String?
  billingRegionSnapshot        String?
  billingPostalCodeSnapshot    String?
  billingCountrySnapshot       String?
  notes                        String?
  discountType                 String?
  discountValue                Int                    @default(0)
  taxRateBasisPoints           Int                    @default(0)
  subtotalCents                Int                    @default(0)
  discountCents                Int                    @default(0)
  taxCents                     Int                    @default(0)
  securityDepositCents         Int                    @default(0)
  securityDepositOverrideCents Int?
  totalCents                   Int                    @default(0)
  archivedAt                   DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  customer                     Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  team                         Team?                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdByUser                User?                  @relation("BookingCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  ownerUser                    User?                  @relation("BookingOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members                      BookingMember[]
  primaryContact               CustomerContact?       @relation(fields: [primaryContactId], references: [id], onDelete: Restrict)
  bookingType                  BookingType            @relation(fields: [bookingTypeId], references: [id], onDelete: Restrict)
  bookingStatus                BookingStatus          @relation(fields: [bookingStatusId], references: [id], onDelete: Restrict)
  lines                        BookingLine[]
  activities                   BookingActivity[]
  generatedContracts           GeneratedContract[]
  payments                     Payment[]
  savedPaymentMethods          SavedPaymentMethod[]
  depositAuthorizations        DepositAuthorization[]
  signingLinks                 SigningLink[]
  checklists                   BookingChecklist[]
  checklistLinks               BookingChecklistLink[]
  pendingUserEmails            PendingBookingUserEmail[]

  @@index([customerId])
  @@index([teamId])
  @@index([createdByUserId])
  @@index([ownerUserId])
  @@index([startDate])
  @@index([bookingStatusId])
  @@index([bookingTypeId])
  @@index([archivedAt])
}

model BookingMember {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([userId])
}

model PendingBookingUserEmail {
  id              String   @id @default(cuid())
  bookingId       String
  normalizedEmail String
  createdAt       DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, normalizedEmail])
  @@index([normalizedEmail])
}

model BookingChecklist {
  id                String                 @id @default(cuid())
  bookingId         String
  flow              String
  status            String                 @default("INCOMPLETE")
  currentStep       Int                    @default(0)
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  booking           Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  completedByUser   User?                  @relation("ChecklistCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  steps             BookingChecklistStep[]
  photos            BookingChecklistPhoto[]

  @@unique([bookingId, flow])
  @@index([bookingId])
}

model BookingChecklistStep {
  id                String                   @id @default(cuid())
  checklistId       String
  stepKey           String
  displayOrder      Int
  status            String                   @default("INCOMPLETE")
  damageReport      String?
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  checklist         BookingChecklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedByUser   User?                    @relation("ChecklistStepCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  photos            BookingChecklistPhoto[]

  @@unique([checklistId, stepKey])
  @@unique([checklistId, displayOrder])
  @@index([checklistId])
}

model BookingChecklistPhoto {
  id          String               @id @default(cuid())
  checklistId String
  stepId      String
  fileReference String             @unique
  createdAt   DateTime             @default(now())
  checklist   BookingChecklist     @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  step        BookingChecklistStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([stepId])
}

model BookingChecklistLink {
  id              String   @id @default(cuid())
  bookingId       String
  flow            String
  tokenHash       String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  revokedAt       DateTime?
  invalidatedAt   DateTime?
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdByUser   User     @relation("ChecklistLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, flow])
}

model BookingLine {
  id                           String                           @id @default(cuid())
  bookingId                    String
  lineType                     String
  sourceCatalogId              String?
  snapshotName                 String
  snapshotDescription          String?
  quantity                     Int
  unitPriceCents               Int
  priceOverrideCents           Int?
  taxable                      Boolean
  lineSubtotalCents            Int
  replacementCostCentsSnapshot Int?
  displayOrder                 Int
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  booking                      Booking                          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bundleComponentSnapshots     BookingBundleComponentSnapshot[]

  @@unique([bookingId, displayOrder])
  @@index([bookingId])
}

model BookingBundleComponentSnapshot {
  id                           String      @id @default(cuid())
  bookingLineId                String
  sourceProductId              String?
  productNameSnapshot          String
  quantityPerBundle            Int
  replacementCostCentsSnapshot Int?
  displayOrder                 Int
  bookingLine                  BookingLine @relation(fields: [bookingLineId], references: [id], onDelete: Restrict)

  @@unique([bookingLineId, displayOrder])
  @@index([bookingLineId])
}

model BookingActivity {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  type      String
  summary   String
  metadata  String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([userId])
}

model ContractTemplate {
  id                 String              @id @default(cuid())
  title              String              @default("Equipment Rental Agreement")
  legalTerms         String              @default("This agreement governs the rental of the listed equipment.")
  footerText         String?
  version            Int                 @default(1)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  generatedContracts GeneratedContract[]

  @@index([isActive])
}

model GeneratedContract {
  id                    String             @id @default(cuid())
  bookingId             String
  generatedByUserId     String
  templateId            String
  version               Int
  status                String             @default("GENERATED")
  templateTitleSnapshot String
  legalTermsSnapshot    String
  footerTextSnapshot    String?
  fileReference         String             @unique
  pricingSnapshotJson   String             @default("{}")
  contentHash           String?
  signedAt              DateTime?
  requiresResignature   Boolean            @default(false)
  generatedAt           DateTime           @default(now())
  downloadedAt          DateTime?
  booking               Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  generatedByUser       User               @relation(fields: [generatedByUserId], references: [id], onDelete: Restrict)
  template              ContractTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  signature             ContractSignature?
  signingLinks          SigningLink[]
  payments              Payment[]

  @@unique([bookingId, version])
  @@index([bookingId])
}

model SigningLink {
  id         String            @id @default(cuid())
  bookingId  String
  contractId String
  tokenHash  String            @unique
  revokedAt  DateTime?
  expiresAt  DateTime?
  viewedAt   DateTime?
  createdAt  DateTime          @default(now())
  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  contract   GeneratedContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([contractId])
}

model ContractSignature {
  id            String            @id @default(cuid())
  contractId    String            @unique
  provider      String            @default("native")
  signerName    String
  signerEmail   String
  signatureData String
  ipAddress     String?
  userAgent     String?
  consentText   String
  consentedAt   DateTime
  contentHash   String
  signedAt      DateTime          @default(now())
  createdAt     DateTime          @default(now())
  contract      GeneratedContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
}

model Payment {
  id                        String             @id @default(cuid())
  bookingId                 String
  contractId                String?
  provider                  String             @default("stripe")
  ownerAccountReference     String?
  status                    String             @default("UNPAID")
  providerCustomerId        String?
  providerCheckoutSessionId String?            @unique
  providerPaymentIntentId   String?            @unique
  paymentUrl                String?
  amountRequestedCents      Int
  amountPaidCents           Int                @default(0)
  amountRefundedCents       Int                @default(0)
  cardConsentText           String?
  cardConsentedAt           DateTime?
  createdAt                 DateTime           @default(now())
  paidAt                    DateTime?
  refundedAt                DateTime?
  booking                   Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  contract                  GeneratedContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([contractId])
  @@index([provider, status])
}

model SavedPaymentMethod {
  id                      String   @id @default(cuid())
  bookingId               String
  customerId              String
  provider                String   @default("stripe")
  providerCustomerId      String
  providerPaymentMethodId String   @unique
  cardBrand               String?
  cardLast4               String?
  consentedAt             DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  booking                 Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer                Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([customerId])
  @@index([provider, providerCustomerId])
}

model DepositAuthorization {
  id                      String    @id @default(cuid())
  bookingId               String
  savedPaymentMethodId    String?
  provider                String    @default("stripe")
  status                  String    @default("NO_CARD")
  providerPaymentIntentId String?   @unique
  amountAuthorizedCents   Int       @default(0)
  amountCapturedCents     Int       @default(0)
  amountRefundedCents     Int       @default(0)
  authorizationExpiresAt  DateTime?
  authorizedAt            DateTime?
  releasedAt              DateTime?
  capturedAt              DateTime?
  refundedAt              DateTime?
  reason                  String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  booking                 Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([provider, status])
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  provider        String   @default("stripe")
  providerEventId String   @unique
  type            String
  processedAt     DateTime @default(now())
}
