generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  role         String    @default("ADMIN")
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  bookingActivities BookingActivity[]
  generatedContracts GeneratedContract[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model CompanySettings {
  id                       String   @id @default("default")
  name                     String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  region                   String?
  postalCode               String?
  country                  String?
  phone                    String?
  email                    String?
  website                  String?
  logoReference            String?
  timezone                 String   @default("America/Denver")
  currency                 String   @default("USD")
  defaultTaxRateBasisPoints Int     @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
}

model BookingType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
}

model BookingStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
}

model Service {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String?
  defaultPriceCents     Int      @default(0)
  isTaxable             Boolean  @default(true)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Customer {
  id           String            @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  normalizedEmail String
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  archivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  contacts     CustomerContact[]
  bookings     Booking[]

  @@index([normalizedEmail])
  @@index([lastName, firstName])
  @@index([archivedAt])
}

model CustomerContact {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  email        String?
  phone        String?
  relationship String?
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  primaryForBookings Booking[]

  @@index([customerId])
  @@index([archivedAt])
}

model Product {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  categoryId           String
  defaultRentalCents   Int             @default(0)
  replacementCostCents Int?
  isTaxable            Boolean         @default(true)
  imageReference       String?
  archivedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  category             ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bundleComponents     BundleComponent[]

  @@index([categoryId])
  @@index([archivedAt])
}

model Bundle {
  id                 String            @id @default(cuid())
  name               String
  description        String?
  fixedRentalCents   Int               @default(0)
  isTaxable          Boolean           @default(true)
  imageReference     String?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  components         BundleComponent[]

  @@index([archivedAt])
}

model BundleComponent {
  id          String  @id @default(cuid())
  bundleId    String
  productId   String
  quantity    Int
  displayOrder Int    @default(0)
  bundle      Bundle  @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bundleId, displayOrder])
  @@index([productId])
}

model Booking {
  id                          String             @id @default(cuid())
  bookingNumber               String             @unique
  title                       String?
  customerId                  String
  primaryContactId            String?
  startDate                   DateTime
  endDate                     DateTime
  bookingTypeId               String
  bookingStatusId             String
  eventAddressLine1           String?
  eventAddressLine2           String?
  eventCity                   String?
  eventRegion                 String?
  eventPostalCode             String?
  eventCountry                String?
  billingAddressLine1Snapshot String?
  billingAddressLine2Snapshot String?
  billingCitySnapshot         String?
  billingRegionSnapshot       String?
  billingPostalCodeSnapshot   String?
  billingCountrySnapshot      String?
  notes                       String?
  discountType                String?
  discountValue               Int                @default(0)
  taxRateBasisPoints          Int                @default(0)
  subtotalCents               Int                @default(0)
  discountCents               Int                @default(0)
  taxCents                    Int                @default(0)
  securityDepositCents        Int                @default(0)
  securityDepositOverrideCents Int?
  totalCents                  Int                @default(0)
  archivedAt                  DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  customer                    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  primaryContact              CustomerContact?   @relation(fields: [primaryContactId], references: [id], onDelete: Restrict)
  bookingType                 BookingType        @relation(fields: [bookingTypeId], references: [id], onDelete: Restrict)
  bookingStatus               BookingStatus      @relation(fields: [bookingStatusId], references: [id], onDelete: Restrict)
  lines                       BookingLine[]
  activities                  BookingActivity[]
  generatedContracts          GeneratedContract[]

  @@index([customerId])
  @@index([startDate])
  @@index([bookingStatusId])
  @@index([bookingTypeId])
  @@index([archivedAt])
}

model BookingLine {
  id                           String                           @id @default(cuid())
  bookingId                    String
  lineType                     String
  sourceCatalogId              String?
  snapshotName                 String
  snapshotDescription          String?
  quantity                     Int
  unitPriceCents               Int
  taxable                      Boolean
  lineSubtotalCents            Int
  replacementCostCentsSnapshot Int?
  displayOrder                 Int
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  booking                      Booking                          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bundleComponentSnapshots     BookingBundleComponentSnapshot[]

  @@unique([bookingId, displayOrder])
  @@index([bookingId])
}

model BookingBundleComponentSnapshot {
  id                           String      @id @default(cuid())
  bookingLineId                String
  sourceProductId              String?
  productNameSnapshot          String
  quantityPerBundle            Int
  replacementCostCentsSnapshot Int?
  displayOrder                 Int
  bookingLine                  BookingLine @relation(fields: [bookingLineId], references: [id], onDelete: Restrict)

  @@unique([bookingLineId, displayOrder])
  @@index([bookingLineId])
}

model BookingActivity {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  type      String
  summary   String
  metadata  String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([userId])
}

model ContractTemplate {
  id             String   @id @default(cuid())
  title          String   @default("Equipment Rental Agreement")
  legalTerms     String   @default("This agreement governs the rental of the listed equipment.")
  footerText     String?
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  generatedContracts GeneratedContract[]

  @@index([isActive])
}

model GeneratedContract {
  id                    String           @id @default(cuid())
  bookingId             String
  generatedByUserId     String
  templateId            String
  version               Int
  status                String           @default("GENERATED")
  templateTitleSnapshot String
  legalTermsSnapshot    String
  footerTextSnapshot    String?
  fileReference         String           @unique
  generatedAt           DateTime         @default(now())
  downloadedAt          DateTime?
  booking               Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  generatedByUser       User             @relation(fields: [generatedByUserId], references: [id], onDelete: Restrict)
  template              ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([bookingId, version])
  @@index([bookingId])
}
